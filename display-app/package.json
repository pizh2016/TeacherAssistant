{
  "name": "classroom-horn-display",
  "version": "0.2.0",
  "description": "喊话小喇叭 - 大屏端 Electron 应用",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:react\" \"npm run electron:dev\"",
    "dev:react": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:start": "cross-env NODE_ENV=production electron .",
    "start": "npm run build && npm run electron:start",
    "build:all": "npm run build && electron-builder --config scripts/electron-builder.yml",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": ["classroom", "horn", "electron"],
  "author": "pishushu",
  "license": "UNLICENSED",
  "type": "commonjs",
  "allowScripts": {
    "electron@*": true,
    "esbuild@*": true
  }
}
